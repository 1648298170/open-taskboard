{
  "name": "@taskboard/cli",
  "version": "0.3.0",
  "description": "taskctl-style CLI for open-taskboard",
  "type": "module",
  "bin": {
    "taskboard": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@taskboard/core": "workspace:*",
    "@taskboard/server": "workspace:*",
    "@taskboard/wake": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
