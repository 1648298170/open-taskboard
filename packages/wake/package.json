{
  "name": "@taskboard/wake",
  "version": "0.3.0",
  "description": "Wake-delivery engine shared by the CLI sidecar and the embedded server (phase 2)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
