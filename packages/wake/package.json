  },
  "dependencies": {
    "@taskboard/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
