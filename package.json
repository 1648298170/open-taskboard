{
  "name": "open-taskboard-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "Local-first issue board for opencode & any agent tool (pnpm monorepo).",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "postinstall": "pnpm -r build",
    "build": "pnpm -r build",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm --filter @taskboard/core build && concurrently -k \"pnpm --filter @taskboard/server dev\" \"pnpm --filter @taskboard/web dev\"",
    "start": "pnpm --filter @taskboard/server start",
    "cli": "pnpm --filter @taskboard/cli cli",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm -r check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "packageManager": "pnpm@9.15.0"
}
